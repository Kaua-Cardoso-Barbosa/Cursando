{
  "expo": {
    "name": "Cursando",
    "slug": "cursando-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#06a663"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "jsEngine": "jsc",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#06a663"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Cursando acessa suas fotos para adicionar imagens a cursos e módulos.",
          "cameraPermission": "O Cursando usa a câmera para fotografar capas de cursos e módulos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Cursando usa o Face ID para confirmar o acesso à sua sessão."
        }
      ]
    ]
  }
}
